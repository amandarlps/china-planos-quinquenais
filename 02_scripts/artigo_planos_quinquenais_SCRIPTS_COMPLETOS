# Função auxiliar para resolução inteligente do caminho do script
encontrar_script <- function(nome_arquivo) {
  caminho_direto <- nome_arquivo
  caminho_subpasta <- file.path("02_scripts", nome_arquivo)
  
  if (file.exists(caminho_direto)) {
    return(caminho_direto)
  } else if (file.exists(caminho_subpasta)) {
    return(caminho_subpasta)
  } else {
    return(caminho_direto)
  }
}


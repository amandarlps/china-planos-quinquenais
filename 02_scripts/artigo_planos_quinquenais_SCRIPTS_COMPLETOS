  rename(
    doc_id = docname,
    contexto_anterior = pre,
    termo_busca = keyword,
    contexto_posterior = post
  ) %>%
  left_join(df_metadados, by = "doc_id") %>%
  select(doc_id, plano, periodo, capitulo_nome, pagina_inicio, pagina_fim, contexto_anterior, termo_busca, contexto_posterior)


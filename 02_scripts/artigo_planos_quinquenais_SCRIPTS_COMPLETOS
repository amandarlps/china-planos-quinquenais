relatorio_execucao <- data.frame(
  Passo = character(),
  Script = character(),
  Status = character(),
  Tempo_Seg = numeric(),
  stringsAsFactors = FALSE
)

# Execução Sequencial Protegida
for (id in names(nomes_scripts)) {
  caminho_script <- encontrar_script(nomes_scripts[[id]])
  
  cat(sprintf("\n▶ [%s] Executando: %s ...\n", id, caminho_script))
  
  if (!file.exists(caminho_script)) {
    cat(sprintf("❌ ERRO CRÍTICO: Script não localizado em '%s'!\n", caminho_script))
    relatorio_execucao <- rbind(relatorio_execucao, data.frame(
      Passo = id, Script = caminho_script, Status = "FALHA (Script Ausente)", Tempo_Seg = 0
    ))
    break
  }
  
  tempo_inicio_step <- Sys.time()
  
  resultado <- tryCatch({
    source(caminho_script, local = FALSE, echo = FALSE)
    "SUCESSO"
  }, error = function(e) {
    cat(sprintf("\n❌ ERRO DURANTE A EXECUÇÃO DO SCRIPT [%s]:\n %s\n", id, e$message))
    return("ERRO")
  })
  
  tempo_fim_step <- Sys.time()
  duracao_step   <- as.numeric(difftime(tempo_fim_step, tempo_inicio_step, units = "secs"))
  
  if (resultado == "SUCESSO") {
    arquivos_esperados <- verificacoes_saida[[id]]
    falhas_saida       <- 0
    
    if (!is.null(arquivos_esperados)) {
      for (arq in arquivos_esperados) {
        if (!file.exists(arq) && !dir.exists(arq)) {
          cat(sprintf("⚠️ ALERTA: Saída esperada não localizada: %s\n", arq))
          falhas_saida <- falhas_saida + 1
        }
      }
    }
    
    status_final <- if (falhas_saida == 0) "CONCLUÍDO (OK)" else "CONCLUÍDO (Incompleto)"
    cat(sprintf("✅ [%s] Concluído em %.2f segundos.\n", id, duracao_step))
    
    relatorio_execucao <- rbind(relatorio_execucao, data.frame(
      Passo = id, Script = caminho_script, Status = status_final, Tempo_Seg = round(duracao_step, 2)
    ))
  } else {
    relatorio_execucao <- rbind(relatorio_execucao, data.frame(
      Passo = id, Script = caminho_script, Status = "FALHA DE EXECUÇÃO", Tempo_Seg = round(duracao_step, 2)
    ))
    cat("\n⛔ Execução interrompida devido a falha no passo anterior.\n")
    break
  }
}

tempo_fim_total   <- Sys.time()
duracao_total_min <- as.numeric(difftime(tempo_fim_total, tempo_inicio_total, units = "mins"))

cat("\n=================================================================\n")
cat(" 🎉 RESUMO FINAL DA EXECUÇÃO DO PIPELINE INTEGRADO\n")
cat("=================================================================\n")
print(relatorio_execucao, row.names = FALSE)
cat(sprintf("\n Tempo Total de Processamento: %.2f minutos\n", duracao_total_min))
cat("=================================================================\n\n")

# Gravação do log final de execução
dir_relatorios <- "03_outputs/relatorios"
if (!dir.exists(dir_relatorios)) dir.create(dir_relatorios, recursive = TRUE, showWarnings = FALSE)
write.csv(relatorio_execucao, file.path(dir_relatorios, "log_execucao_pipeline.csv"), row.names = FALSE)
